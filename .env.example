# ==============================================================================
# CW RESEARCH PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. DO NOT COMMIT .env TO GIT.
# ==============================================================================

# Backend Service
PORT=8501
HOST=0.0.0.0
ENVIRONMENT=development

# AI Research Assistant (OpenRouter)
AI_ENABLED=true
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=stealth/ox-alpha
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://github.com/nigelnh/cw-research-platform
OPENROUTER_APP_NAME=CW Research Platform

# Request & Rate Limits
AI_MAX_MESSAGES=20
AI_MAX_MESSAGE_LENGTH=4000
AI_TIMEOUT_SECONDS=60.0
AI_TEMPERATURE=0.2

# Market Data Provider (FiinQuant)
MARKET_DATA_PROVIDER=fiinquant
FIINQUANT_USERNAME=your_fiinquant_username_here
FIINQUANT_PASSWORD=your_fiinquant_password_here
FIINQUANT_MAX_REALTIME_SYMBOLS=33
FIINQUANT_ENABLED=true
FIINQUANT_DEBOUNCE_MS=300

# Durable Historical Market-Data Persistence (PostgreSQL) - OFF by default.
# Storage foundation only; the realtime path and historical API do not depend on this yet.
# DATABASE_ENABLED=false
# DATABASE_URL=postgresql+asyncpg://cw:cw@localhost:5432/cw_research
# DATABASE_REQUIRE_ON_STARTUP=false
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# Alembic (migrations) can also read ALEMBIC_DATABASE_URL directly:
# ALEMBIC_DATABASE_URL=postgresql+psycopg2://cw:cw@localhost:5432/cw_research

# Historical ingestion (Step 6) - conservative, resumable, quota-safe FiinQuant backfill.
# The FiinQuant account has a ~1-year historical LOOKBACK entitlement (verified 2026-08):
# request span up to ~355 days is fine, but any window older than ~1 year returns HTTP 403.
# INGEST_MAX_LOOKBACK_DAYS=360
# INGEST_MAX_CHUNK_SPAN_DAYS=350
# INGEST_MAX_CONCURRENT_REQUESTS=1     # FiinQuant rate-limits aggressive parallel historical fetches
# INGEST_MIN_REQUEST_INTERVAL_SECONDS=2.0
# INGEST_MAX_RETRIES=5
# INGEST_MAX_SYMBOLS_PER_INVOCATION=60

# Historical read path (Step 7) - PostgreSQL-first /api/market/history.
# auto (default): postgres_first when DATABASE_ENABLED and reachable, else provider_direct.
# HISTORY_SOURCE_MODE=auto
# HISTORY_POSTGRES_TIMEFRAMES=1d       # only daily is served PostgreSQL-first
# HISTORY_GAPFILL_ENABLED=true
# HISTORY_GAPFILL_LOCK_WAIT_SECONDS=25
# HISTORY_MAX_RANGE_DAYS=1500          # PG may hold more than the 360d provider horizon
# HISTORY_MAX_RESULT_BARS=6000
# HISTORY_DEFAULT_LOOKBACK_DAYS=400
# HV_POSTGRES_MIN_BARS_FOR_FILL=40     # HV triggers a controlled off-tick fill below this

# ==============================================================================
# Authentication (Step 9) - Supabase Auth. OPTIONAL: the whole public product
# (dashboard, research, market data, quant, history, websocket) runs with NONE of
# these set. They are required only for the user-owned /api/me/* namespace
# (persisted primary watchlist) and the "Sign in" UI.
# ==============================================================================
# --- Backend: verifies (never issues) Supabase access tokens -------------------
# Preferred (asymmetric): set only the project URL; the backend fetches + caches
# the project JWKS and verifies RS256/ES256 by key id. No secret on the server.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_JWT_AUDIENCE=authenticated            # default; rarely change
# Legacy (shared secret / HS256) - only if your project still uses it:
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
# Overrides (normally derived from SUPABASE_URL):
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_CACHE_SECONDS=600
# AUTH_JWT_LEEWAY_SECONDS=30
# ME_WATCHLIST_MAX_ITEMS=50
# TEST ONLY - never set in a deployed environment. Ignored when ENVIRONMENT=production.
# Lets local dev / CI accept HS256 tokens signed with this secret without a real project.
# AUTH_TEST_HS256_SECRET=
#
# The persisted watchlist also needs the PostgreSQL persistence layer enabled:
# DATABASE_ENABLED=true
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/cw_research
# (run `alembic upgrade head` after enabling)

# ==============================================================================
# Frontend Configuration
# ==============================================================================
VITE_DATA_MODE=mock
VITE_DEFAULT_LIVE_SYMBOLS=VNINDEX
VITE_MAX_REALTIME_SYMBOLS=33
VITE_API_URL=http://localhost:8501

# Frontend auth (client-safe values only - publishable, never the service-role key).
# When BOTH are set the "Sign in" control appears; otherwise the app is anonymous-only.
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here
