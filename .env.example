# ==============================================================================
# CW RESEARCH TERMINAL ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. DO NOT COMMIT .env TO GIT.
# ==============================================================================

# Backend Service
PORT=8501
HOST=0.0.0.0
ENVIRONMENT=development

# AI Research Assistant (OpenRouter)
AI_ENABLED=true
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=stealth/ox-alpha
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://github.com/nigelnh/cw-research-terminal
OPENROUTER_APP_NAME=CW Research Terminal

# Request & Rate Limits
AI_MAX_MESSAGES=20
AI_MAX_MESSAGE_LENGTH=4000
AI_TIMEOUT_SECONDS=60.0
AI_TEMPERATURE=0.2

# Market Data Provider (Vnstock Community; server-side only key)
MARKET_DATA_PROVIDER=vnstock
VNSTOCK_API_KEY=your_vnstock_api_key_here
VNSTOCK_ENABLED=true
MARKET_DATA_MAX_SYMBOLS=60
MARKET_DATA_DEBOUNCE_MS=300
VNSTOCK_QUOTE_POLL_SECONDS=5
VNSTOCK_TAPE_SWEEP_SECONDS=120
VNSTOCK_TAPE_PAGE_SIZE=100
VNSTOCK_MIN_REQUEST_INTERVAL_SECONDS=1.2
VNSTOCK_FEED_FRESHNESS_SECONDS=15

# Durable Historical Market-Data Persistence (PostgreSQL) - OFF by default.
# Storage foundation only; the realtime path and historical API do not depend on this yet.
# DATABASE_ENABLED=false
# DATABASE_URL=postgresql+asyncpg://cw:cw@localhost:5432/cw_research
# DATABASE_REQUIRE_ON_STARTUP=false
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# Alembic (migrations) can also read ALEMBIC_DATABASE_URL directly:
# ALEMBIC_DATABASE_URL=postgresql+psycopg2://cw:cw@localhost:5432/cw_research

# Historical ingestion (Step 6) - conservative, resumable and quota-safe.
# The default request floor is shared with live polling to stay below the Vnstock
# Community allowance. Increase concurrency only with a verified higher entitlement.
# INGEST_MAX_LOOKBACK_DAYS=360
# INGEST_MAX_CHUNK_SPAN_DAYS=350
# INGEST_MAX_CONCURRENT_REQUESTS=1
# INGEST_MIN_REQUEST_INTERVAL_SECONDS=2.0
# INGEST_MAX_RETRIES=5
# INGEST_MAX_SYMBOLS_PER_INVOCATION=60

# Historical read path (Step 7) - PostgreSQL-first /api/market/history.
# auto (default): postgres_first when DATABASE_ENABLED and reachable, else provider_direct.
# HISTORY_SOURCE_MODE=auto
# HISTORY_POSTGRES_TIMEFRAMES=1d       # only daily is served PostgreSQL-first
# HISTORY_GAPFILL_ENABLED=true
# HISTORY_GAPFILL_LOCK_WAIT_SECONDS=25
# HISTORY_MAX_RANGE_DAYS=1500          # PG may hold more than the 360d provider horizon
# HISTORY_MAX_RESULT_BARS=6000
# HISTORY_DEFAULT_LOOKBACK_DAYS=400
# HV_POSTGRES_MIN_BARS_FOR_FILL=40     # HV triggers a controlled off-tick fill below this

# ==============================================================================
# Authentication (Step 9) - Supabase Auth. OPTIONAL: the whole public product
# (dashboard, research, market data, quant, history, websocket) runs with NONE of
# these set. They are required only for the user-owned /api/me/* namespace
# (persisted primary watchlist) and the "Sign in" UI.
# ==============================================================================
# --- Backend: verifies (never issues) Supabase access tokens -------------------
# Preferred (asymmetric): set only the project URL; the backend fetches + caches
# the project JWKS and verifies RS256/ES256 by key id. No secret on the server.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_JWT_AUDIENCE=authenticated            # default; rarely change
# Legacy (shared secret / HS256) - only if your project still uses it:
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
# Overrides (normally derived from SUPABASE_URL):
# SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_CACHE_SECONDS=600
# AUTH_JWT_LEEWAY_SECONDS=30
# ME_WATCHLIST_MAX_ITEMS=50
# TEST ONLY - never set in a deployed environment. Ignored when ENVIRONMENT=production.
# Lets local dev / CI accept HS256 tokens signed with this secret without a real project.
# AUTH_TEST_HS256_SECRET=
#
# The persisted watchlist also needs the PostgreSQL persistence layer enabled:
# DATABASE_ENABLED=true
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/cw_research
# (run `alembic upgrade head` after enabling)

# ==============================================================================
# Step 10 - Public API hardening. All defaults are safe for local development; the
# values below are only needed for a real (multi-worker / reverse-proxied) deployment.
# ==============================================================================
# ---- master switches (leave true; flip a feature off if it misbehaves) ----
# PUBLIC_RATE_LIMIT_ENABLED=true
# AI_PUBLIC_ENABLED=true            # false -> /api/ai/* returns 503 cleanly, rest of app fine
# PUBLIC_REALTIME_ENABLED=true      # false -> /ws/market upgrades are refused
# SECURITY_HEADERS_ENABLED=true
# SECURITY_HSTS_ENABLED=false       # true ONLY when the deployment is HTTPS end-to-end

# ---- rate-limit backend ----
# RATE_LIMIT_BACKEND=auto           # auto | memory | redis  (auto = redis when REDIS_ENABLED + reachable)
# RATE_LIMIT_REDIS_URL=             # empty -> reuse REDIS_URL. Keyed under cw_research:ratelimit:v1
# RATE_LIMIT_FAIL_OPEN=false        # redis error -> false: conservative in-process fallback; true: allow. AI is always fail-closed.

# ---- client IP (rate-limit key only) ----
# CLIENT_IP_TRUST_MODE=            # direct | cidr | railway. Empty -> cidr if RATE_LIMIT_TRUST_PROXY else direct
#   direct  : socket peer; forwarded headers ignored (local/dev, or app-is-edge)
#   cidr    : trust X-Forwarded-For only from a peer in TRUSTED_PROXY_CIDRS (generic reverse proxy)
#   railway : trust ONLY the left-most X-Forwarded-For, and only when ENVIRONMENT=production on a
#             verified Railway service (RAILWAY_* env). Deploy the Railway service with CDN disabled.
# RATE_LIMIT_TRUST_PROXY=false      # legacy switch for 'cidr' mode
# TRUSTED_PROXY_CIDRS=              # 'cidr' mode: e.g. 10.0.0.0/8,127.0.0.1/32 - XFF from any other peer is ignored

# ---- per-tier limits (requests / window), keyed per client ----
# RL_HEALTH_PER_MIN=120
# RL_MARKET_PER_MIN=120
# RL_QUANT_PER_MIN=40
# RL_HISTORY_PER_MIN=20
# RL_AI_PER_MIN=6
# RL_AI_PER_HOUR=40
# RL_ME_PER_MIN=30
# RL_DEFAULT_PER_MIN=60

# ---- request body size ----
# API_MAX_BODY_BYTES=65536          # 64 KiB for quant / watchlist / reconcile
# AI_MAX_BODY_BYTES=262144          # 256 KiB for /api/ai/*

# ---- AI cost controls ----
# AI_MAX_INPUT_CHARS=12000
# AI_MAX_MESSAGES=20
# AI_MAX_MESSAGE_LENGTH=4000
# AI_MAX_CONCURRENT=3
# AI_MAX_OUTPUT_TOKENS=1024
# AI_ACQUIRE_TIMEOUT_SECONDS=5
# AI_DAILY_REQUEST_BUDGET=0         # >0 -> single-process per-UTC-day cap on total AI requests

# ---- history HTTP-layer protection (separate from ingestion throttling) ----
# HISTORY_MAX_CONCURRENT_GAPFILLS=2

# ---- websocket ----
# WS_MAX_CONNECTIONS_TOTAL=200
# WS_MAX_CONNECTIONS_PER_IP=8
# WS_MAX_SYMBOLS_PER_CLIENT=40      # server universe still enforces MARKET_DATA_MAX_SYMBOLS
# WS_MAX_MESSAGE_BYTES=16384
# WS_MESSAGE_BURST=30
# WS_MESSAGE_WINDOW_SECONDS=10
# WS_IDLE_TIMEOUT_SECONDS=300

# ---- quant /calculate input bounds (far outside any real CW input) ----
# QUANT_CALC_MAX_PRICE=1e12
# QUANT_CALC_MAX_T_YEARS=100
# QUANT_CALC_MAX_SIGMA=50
# QUANT_CALC_MAX_RATIO=1e6
# INSTRUMENTS_RECONCILE_MAX_SYMBOLS=5000

# ---- CORS / host policy (REQUIRED in production) ----
# CORS_ALLOWED_ORIGINS=             # comma-separated exact origins, e.g. https://app.example.com
#                                     empty in dev -> localhost:3000/5173; empty in prod -> browsers blocked
# ALLOWED_HOSTS=                    # comma-separated Host allow-list; empty -> not enforced (dev only)

# ---- outbound timeout ----
# JWKS_FETCH_TIMEOUT_SECONDS=5

# ==============================================================================
# Frontend Configuration
# ==============================================================================
VITE_DATA_MODE=mock
VITE_DEFAULT_LIVE_SYMBOLS=VNINDEX
VITE_MAX_REALTIME_SYMBOLS=33
VITE_API_URL=http://localhost:8501

# Frontend auth (client-safe values only - publishable, never the service-role key).
# When BOTH are set the "Sign in" control appears; otherwise the app is anonymous-only.
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here
