# FiinQuant Authentication & Test Configuration
# Copy this file to .env and provide your valid credentials:
# cp .env.example .env

# Official FiinQuant Credentials
FIINQUANT_USERNAME=your_username_here
FIINQUANT_PASSWORD=your_password_here

# Test Instruments Configuration
FIINQUANT_TEST_STOCK_1=HPG
FIINQUANT_TEST_STOCK_2=FPT
FIINQUANT_TEST_INDEX=VNINDEX

# Active HOSE Covered Warrant Symbol for Testing (must be a currently listed, unexpired CW confirmed from exchange)
FIINQUANT_TEST_CW_SYMBOL=YOUR_ACTIVE_HOSE_CW_SYMBOL

# Probe Execution Limits
FIINQUANT_PROBE_EVENT_LIMIT=5
FIINQUANT_PROBE_TIMEOUT_SECONDS=15
