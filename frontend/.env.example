# CW Research Platform Environment Configuration Example
# Copy to .env for local development

# Data Mode: 'live' (default) | 'hybrid'
VITE_DATA_MODE=live

# FastAPI Backend Service REST URL
VITE_API_URL=http://localhost:8501

# FastAPI Backend Market WebSocket URL (includes canonical /ws/market path)
VITE_WS_URL=ws://localhost:8501/ws/market
