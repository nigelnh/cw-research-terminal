# CW Research Platform Environment Configuration Example
# Copy to .env for local development

# Data Mode: 'mock' (default, zero infrastructure) | 'live' (requires cw_gui) | 'hybrid'
VITE_DATA_MODE=mock

# cw_gui FastAPI Backend Service URL (used when VITE_DATA_MODE=live)
VITE_CW_GUI_REST_URL=http://localhost:8000

# cw_gui WebSocket Gateway Service URL (used when VITE_DATA_MODE=live)
VITE_CW_GUI_WS_URL=ws://localhost:8787
