dump.rdb
*.rdb
appendonly.aof
# Local database / runtime state
*.sqlite
*.sqlite3
*.db
backend/.pytest_cache/
.pytest_cache/
.ruff_cache/
# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
