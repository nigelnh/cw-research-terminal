cw_pg_test_*/

# ==============================================================================
# Logs
# ==============================================================================
*.log

# ==============================================================================
# OS / IDE / conflict copies
# ==============================================================================
.DS_Store
.vscode/
.idea/
.cursor/
# iCloud/Finder conflict-copy pattern. NARROW on purpose: only "<name> 2.<ext>" /
# "<name> 3.<ext>" siblings, never a legitimate file. Re-check `git status` after edits.
* 2.py
* 3.py
* 2.ts
* 3.ts
* 2.tsx
* 3.tsx

# ==============================================================================
# ngrok
# ==============================================================================
bin/

# ==============================================================================
# Decommissioned prefixes. These held an older Node/Postgres prototype, prod-API
# scratch scripts (real broker credentials in history - see the secret-audit report),
# and recovered internal-terminal formula-verification scripts. All superseded by
# backend/ + frontend/. Rooted (/...) so they never shadow real source.
# ==============================================================================
/legacy/
/server/
/scratch/

# ==============================================================================
# AI agent / assistant tooling — local to each machine, never committed
# ==============================================================================
.claude/
.agents/
.mcp.json
CLAUDE.md
AGENTS.md

# ==============================================================================
# Local-only dev material: one-off audit/benchmark scripts, the FiinQuant POC,
# and dated plans/reports/design hand-offs. Only the docs the code links to
# (docs/domain/, docs/design/LANGUAGE_POLICY.md) are tracked.
# ==============================================================================
/audit/
/backend/poc/
/docs/*.md
/docs/internal/
/docs/design/*
!/docs/design/LANGUAGE_POLICY.md

# ==============================================================================
# Misc
# ==============================================================================
performance_test_cw.js
/tests/
server/archive/
.vercel

# local recovery / ops scratch — never commit
scratchpad/
